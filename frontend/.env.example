# =====================================================================
# Food Packaging AI - Frontend Environment Configuration (Vite / Render)
# =====================================================================

# Public URL of the deployed FastAPI Backend Web Service on Render.
# Example: https://food-packaging-ai-backend.onrender.com
# 
# NOTE: In local development, leave this empty or commented out so Vite proxies
# requests to http://127.0.0.1:8000.
# On Render Static Site, set this in the Environment Variables tab before building.
VITE_API_BASE_URL=https://food-packaging-ai-backend.onrender.com
