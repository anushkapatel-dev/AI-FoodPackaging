# =====================================================================
# Food Packaging AI - Frontend Environment Configuration
# =====================================================================

# Backend API Base URL Configuration:
#
# - VERCEL UNIFIED DEPLOYMENT (Recommended):
#   Leave VITE_API_BASE_URL empty or unset!
#   The frontend and FastAPI backend are deployed on the same Vercel domain.
#   All API requests automatically use same-origin relative URLs (/api/...).
#
# - LOCAL DEVELOPMENT:
#   Leave VITE_API_BASE_URL empty or unset.
#   Vite automatically proxies /api to http://127.0.0.1:8000.
#
# - EXTERNAL BACKEND (e.g. Render / Custom domain):
#   Set to the public URL of the remote backend service:
#   VITE_API_BASE_URL=https://your-backend.onrender.com
#
VITE_API_BASE_URL=
