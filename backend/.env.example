# =====================================================================
# Food Packaging AI - Backend Environment Configuration (Render / Prod)
# =====================================================================

# Server Port (Render automatically sets $PORT in production)
PORT=8000

# Server Host Binding (0.0.0.0 is required for Render container routing)
HOST=0.0.0.0

# CORS Allowed Origins
# Comma-separated list of origins allowed to make API requests.
# Example: https://food-packaging-ai-frontend.onrender.com,http://localhost:5173
# Note: Any https://*.onrender.com domain and localhost are permitted by default if left blank.
CORS_ORIGINS=
